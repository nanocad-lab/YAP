    "import numpy as np\n",
    "from utils.util import *\n",
    "import time\n",
    "import os\n",
    "import matplotlib.pyplot as plt\n",
    "from assembly_yield_calculator import Pad_Yield_Map_Generator\n",
    "\n",
    "# Load configuration\n",
    "cfg = load_modeling_config(path='configs/HBM_footprint_A_dummy_row_4_config.yaml', \n",
    "                     mode='d2w_modeling',\n",
    "                     debug=False)\n",
    "if cfg.DEBUG:\n",
    "    print(\"Debug mode is ON.\")\n",
    "# If the directory does not exist, create it\n",
    "if not os.path.exists(cfg.OUTPUT_DIR + cfg.DESIGN):\n",
    "    os.makedirs(cfg.OUTPUT_DIR + cfg.DESIGN)\n",
    "\n",
    "update_config_items(cfg=cfg, mode='d2w_modeling')\n",
    "\n",
    "pad_bitmap_collection = convert_3dblox_to_pad_bitmap(cfg=cfg,\n",
    "                            blox_bmap_path='input/' + cfg.DESIGN + '.bmap',\n",
    "                            pad_arrange_pattern=cfg.PAD_ARRANGE_PATTERN,)\n",
    "\n",
    "\n",
    "# Calculate the yield\n",
    "start_time = time.time()\n",
    "Pad_Yield_Map_Generator(\n",
    "    cfg=cfg, \n",
    "    pad_bitmap_collection=pad_bitmap_collection,\n",
    ")\n",
    "os.remove(cfg.OUTPUT_DIR + cfg.DESIGN + '/' + cfg.DESIGN + \"_bitmap_collection.npy\")  # Remove intermediate file to save space"
   ]
