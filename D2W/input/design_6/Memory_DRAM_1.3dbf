Bump_Types:
  silicon_individual_bonding:
    bump_size: 5
    through_via_size: 5
    bump_subckt: [DO_NOT_USE.subckt, DO_NOT_USE]
    tv_subckt: [DO_NOT_USE.subckt, DO_NOT_USE]
Chiplet_Grid:
  pitch: 10
Voltage_Areas:
  Memory_DRAM_1_va:
    net: VDD
    pixel_model: default_pixel_model
    power: 1.0
    coords: [[0.0, 0.0], [40.0, 0.0], [40.0, 40.0], [0.0, 40.0]]
PG_Net_Type:
  VDD:
    voltage: 0.8
Pixel_Models:
  default_pixel_model:
    type: default
    voltage: 0.8
    resistances: [1.0, 1.0, 1.0]
    model: [DO_NOT_USE.subckt, DO_NOT_USE]
Thermal_Layers:
  Memory_DRAM_1_layer1:
    type: conductor
    side: front
    thickness: 10
Thermal_Connections:
  Memory_DRAM_1_conn1:
    metal_conductivity: 200.0
    dielectric_conductivity: 0.2
