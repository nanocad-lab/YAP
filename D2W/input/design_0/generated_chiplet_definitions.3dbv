Header:
  version: 2.0
  unit: micron
  precision: 2000
ChipletDef:
  interposer:
    type: substrate
    chiplets:
    design_area: [3162, 3162]
    seal_ring_width: [0, 0, 0, 0]
    scribe_line_remaining_width: [0, 0, 0, 0]
    thickness: 100
    shrink: 1
    tsv: true
    cad_layer:
    regions:
      r1:
        bmap: bmap_files/interposer_r1.bmap
        pmap: DO_NOT_USE.pmap
        side: front
        layer: UBM
        gds_layer:
        coords:
        - [0, 0]
        - [3162, 0]
        - [3162, 3162]
        - [0, 3162]
    external:
      3dbf_file: 3dbf_files/interposer.3dbf
  CPU:
    type: die
    chiplets:
    design_area: [3162, 3162]
    seal_ring_width: [0, 0, 0, 0]
    scribe_line_remaining_width: [0, 0, 0, 0]
    thickness: 100
    shrink: 1
    tsv: true
    cad_layer:
    regions:
      From_interposer:
        bmap: bmap_files/CPU_From_interposer.bmap
        pmap: DO_NOT_USE.pmap
        side: back
        layer: UBM
        gds_layer:
        coords:
        - [0, 0]
        - [3162, 0]
        - [3162, 3162]
        - [0, 3162]
    external:
      3dbf_file: 3dbf_files/CPU.3dbf
