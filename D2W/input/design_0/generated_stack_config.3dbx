Header:
  version: 2.0
  unit: micron
  precision: 2000
  include:
  - input/design_0/generated_chiplet_definitions.3dbv
Design:
  name: interposer
ChipletInst:
  interposer_0:
    reference: interposer
    is_master: 'true'
  CPU_1:
    reference: CPU
    is_master: 'true'
Stack:
  interposer_0:
    loc: [0, 0]
    z: 0
    orient: R0
    root: 'true'
  CPU_1:
    loc: [0, 0]
    z: 100
    orient: R0
Connection:
  Conn1:
    top: CPU_1.regions.From_interposer
    bot: interposer_0.regions.To_CPU